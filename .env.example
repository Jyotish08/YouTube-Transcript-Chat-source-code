# Supabase Edge Functions Secrets (set via: supabase secrets set ...)
# AI & Embeddings (AI/ML API is primary; OpenAI or Vercel AI Gateway also supported)
AIML_API_KEY=your_aiml_api_key
# Optional fallback keys:
# OPENAI_API_KEY=your_openai_api_key
# VERCEL_AI_GATEWAY_KEY=your_vercel_ai_gateway_key

# Video Ingestion Specialists
BRIGHTDATA_API_KEY=your_brightdata_api_key
SPEECHMATICS_API_KEY=your_speechmatics_api_key
BRIGHTDATA_ZONE=web_unlocker1

# Frontend (Vite) - set in .env.local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
